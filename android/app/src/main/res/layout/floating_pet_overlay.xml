<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="8dp">

    <!-- 1. Floating Speech Bubble (Above Chibi's Head) -->
    <LinearLayout
        android:id="@+id/bubbleLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="230dp"
        android:background="@drawable/bubble_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvSpeech"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="200dp"
            android:text="I'm floating on your screen! Tap me to poke or chat! ☁️✨"
            android:textColor="#1E293B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center" />

        <ProgressBar
            android:id="@+id/thinkingProgress"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 2. Scene: Chibi Character Standing on the Fluffy Cloud Pedestal -->
    <FrameLayout
        android:id="@+id/characterScene"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false">

        <!-- Cloud Pedestal (Under her shoes) -->
        <ImageView
            android:id="@+id/ivCloud"
            android:layout_width="125dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|center_horizontal"
            android:src="@drawable/cloud_pedestal"
            android:scaleType="fitCenter" />

        <!-- Chibi Character Sprite (Standing atop the cloud) -->
        <ImageView
            android:id="@+id/ivChibi"
            android:layout_width="100dp"
            android:layout_height="145dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:src="@drawable/chibi_standing"
            android:scaleType="fitCenter" />

        <!-- Expression Badge (✨, 💖, 💭) -->
        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:background="@drawable/send_btn_bg"
            android:backgroundTint="#FFFFFF"
            android:gravity="center"
            android:text="✨"
            android:textSize="12sp"
            android:elevation="4dp" />

        <!-- Subtle Menu / Chat Toggle Button -->
        <TextView
            android:id="@+id/btnToggleMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="4dp"
            android:background="@drawable/menu_pill_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="Chibi ☰"
            android:textColor="#334155"
            android:textSize="11sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- 3. Expandable Floating Chat & Action Panel (Zero-Keyboard Chips + Custom Input) -->
    <LinearLayout
        android:id="@+id/chatCard"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:background="@drawable/chat_panel_bg"
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_marginTop="6dp"
        android:elevation="8dp"
        android:visibility="gone">

        <!-- Top Header: Title & Close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="☁️ Chat with Chibi"
                android:textColor="#1E293B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClosePanel"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quick Action Chips (Instant 0% battery replies) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/chipJoke"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="😆 Joke"
                android:textColor="#334155"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Space android:layout_width="4dp" android:layout_height="0dp" />

            <TextView
                android:id="@+id/chipInspire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="💖 Inspire"
                android:textColor="#334155"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Space android:layout_width="4dp" android:layout_height="0dp" />

            <TextView
                android:id="@+id/chipFact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="🌟 Fact"
                android:textColor="#334155"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Space android:layout_width="4dp" android:layout_height="0dp" />

            <TextView
                android:id="@+id/chipMath"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="🔢 Math"
                android:textColor="#334155"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Custom Input Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etPrompt"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/input_bg"
                android:hint="Ask anything..."
                android:textSize="12sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#1E293B"
                android:textColorHint="#94A3B8"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:maxLines="1" />

            <Space android:layout_width="6dp" android:layout_height="0dp" />

            <Button
                android:id="@+id/btnSend"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/send_btn_bg"
                android:text="🚀"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Close / Dismiss Service Button -->
        <TextView
            android:id="@+id/btnDismissService"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="Dismiss Overlay"
            android:textColor="#EF4444"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
